from si import *

CLI_ARGS = cli_args()

arg!(name: Str, default: Num): Num = {
    prefixed = "--" + name
    return if CLI_ARGS.contains(prefixed) then CLI_ARGS[CLI_ARGS.indexof(prefixed) + 1] -> Num else default
}

DRY_MASS = 22200.0 kg # (Stage 1 empty)
INITIAL_FUEL = 6000.0 kg  # (Fuel remaining for landing burn)
ROCKET_HEIGHT = 47.0 m
ROCKET_RADIUS = 1.83 m
ENGINE_THRUST = 845000.0 N  # (1x Merlin 1D Engine, throttled approx 100%)
RCS_TORQUE = 600000.0 N*m  # (Cold gas thrusters + grid fins approx)
ISP = 282.0 s  # Specific Impulse at sea level
FUEL_DENSITY = 0.81 kg/L # Kerosine

# Environment
GRAVITY = 9.81 m/s^2
AIR_DENSITY = 1.225 kg/m^3 # (Sea level)
DRAG_COEFF_BASE = 1.5  # Drag coefficient falling engine-first
DRAG_COEFF_SIDE = 2.1  # Drag coefficient falling sideways

# Game Settings
SCALE = 0.4m
INACTIVITY_COOLDOWN = 10 s # Time before resetting to title screen after no input
INVERT = false
AUTOZOOM = true
HEADLESS = CLI_ARGS.contains("--headless")

FPS = arg("fps", 60)
DT = 1.0 / FPS -> s # Physics time step

# Screen dimensions in pixels and meters
SCREEN_WIDTH = 980
SCREEN_HEIGHT = 980
SCREEN_WIDTH_M = SCREEN_WIDTH * SCALE
SCREEN_HEIGHT_M = SCREEN_HEIGHT * SCALE
PLATFORM_WIDTH = 60.0 m
MARGIN = 50.0m

# Landing Constraints
MAX_LANDING_SPEED_Y = 12.0 m/s
MAX_LANDING_SPEED_X = 5.0 m/s
MAX_LANDING_ANGLE = 10.0°
MAX_ROTATION_SPEED = 10.0°/s

# =========================================

# Drive rocket to target angle, damp spin
ATTITUDE_KP = arg("attitude_kp", 1.673) -> rad^(-1)
ATTITUDE_KD = arg("attitude_kd", 1.504) -> s*rad^(-1)

# Lateral correction: desired lean = KP*x_error + KD*vx
LATERAL_KP = arg("lateral_kp", 0.002) -> m^(-1)
LATERAL_KD = arg("lateral_kd", 0.014) -> s*m^(-1)

# Max lean angles per phase
AUTOPILOT_MAX_LEAN_COARSE = arg("max_lean_coarse", 24.347) -> °
AUTOPILOT_MAX_LEAN_BURN   = arg("max_lean_burn", 12.755) -> °
AUTOPILOT_MAX_LEAN_FINAL  = arg("max_lean_final", 16.299) -> °

# Phase Thresholds
PHASE_BURN_ALT = arg("phase_burn_alt", 212.382) -> m
PHASE_FINAL_ALT = arg("phase_final_alt", 10.0) -> m
BURN_MIN_VY = arg("burn_min_vy", 1.007) -> m/s
BURN_SAFETY_MARGIN = arg("burn_safety_margin", 5.354) -> m
BURN_THRESHOLD_FRACTION = arg("burn_threshold_fraction", 0.517)
FINAL_TARGET_VY = arg("final_target_vy", 1.566) -> m/s

# RCS Deadbands (lower = more precise)
RCS_DEADBAND_COARSE = arg("rcs_deadband_coarse", 0.054)
RCS_DEADBAND_BURN   = arg("rcs_deadband_burn", 0.021)
RCS_DEADBAND_FINAL  = arg("rcs_deadband_final", 0.008)
