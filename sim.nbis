from si import *
import random
import math
import graphics
import time
from math import roundn
from consts import *

# Status
started = false
crashed = false
landed = false
score = 0
landing_bonus = 0
last_time = time.now() -> s
actual_fps = 60.0 s^(-1)
idle_time = 0.0 s
fade_time = 0.0 s
crash_time = 0.0 s

# More params
wind_time = 0.0 s
wind_speed = 0.0 m/s
ctrl_mode = false

# Rocket State & Controls
struct Rocket {
    # State
    x: Length = random.uniform(-140.0, 140.0) -> m,
    y: Length = -450.0 m,
    vx: Velocity = random.uniform(-35.0, 35.0) -> m/s,
    vy: Velocity = random.uniform(30.0, 60.0) -> m/s,
    angle: Angle = random.uniform(-0.4, 0.4) -> rad,
    omega: AngularVelocity = random.uniform(-0.2, 0.2) -> rad/s,
    fuel: Mass = INITIAL_FUEL,
    mass: Mass = DRY_MASS + INITIAL_FUEL,

    # Controls
    engine_on: Bool = false,
    rcs_left: Bool = false,
    rcs_right: Bool = false,
}

# Platform params
struct Platform {
    x: Length = -PLATFORM_WIDTH / 2,
    y: Length = -5.0 m,
    w: Length = PLATFORM_WIDTH,
    h: Length = 5.0 m,
}

# Particles
struct Particle {
    x: Length,
    y: Length,
    vx: Velocity,
    vy: Velocity,
    life: Time,
    max_life: Time,
    color: Str
}

# Colors
sky_colors = ["#4a7faa", "#4d89b8", "#5293c6", "#5a9fd4", "#65aee0", "#74baeb", "#87c8f4", "#9bd8ff"]
rocket_colors = ["#9a9a9a", "#bcbcbc", "#dadada", "#ededed", "#f5f5f5", "#ffffff"]
fuel_colors = ["#c0392b", "#e74c3c", "#e67e22", "#f39c12", "#f1c40f", "#f7dc6f", "#abebc6", "#82e0aa", "#58d68d", "#2ecc71"]
exhaust_colors = ["#2a2a2a11","#3a3a3a22","#4a4a4a33","#6a6a6a55","#8a8a8a77","#b0a8a099","#d8c0b0bb","#f2d0c0cc","#ffd8cadd","#ffe5dfee"]
fire_colors = ["#333333", "#ff2200", "#ff6600", "#ffcc00", "#333333", "#ff2200", "#ff6600", "#ffcc00", "#333333", "#ff2200", "#ff6600", "#ffcc00", "#333333", "#ff2200", "#ff6600", "#ffcc00"]

# Globals
rckt: {Rocket} = Rocket()
platform: {Platform} = Platform()
particles: List[{Particle}] = []

# Initialize graphics
graphics.init(SCREEN_WIDTH, SCREEN_HEIGHT)
graphics.set_title("Falcon 9 Landing Simulator")
graphics.set_font("Fira Code")

reset!() = {
    global rckt, particles, started, crashed, landed, idle_time, wind_time, wind_speed, crash_time, score, landing_bonus

    rckt = Rocket()
    particles = []
    started = false
    crashed = false
    landed = false
    score = 0
    landing_bonus = 0
    idle_time = 0.0 s
    wind_time = 0.0 s
    wind_speed = 0.0 m/s
    crash_time = 0.0 s
}


# ==============================
update_physics!() = {
    global rckt, crashed, landed, wind_speed, DT

    if crashed or landed then {return;}

    rckt.mass = DRY_MASS + rckt.fuel
    moi = (1.0 / 12.0) * rckt.mass * (3 * ROCKET_RADIUS^2 + ROCKET_HEIGHT^2)

    force_x = 0.0 N
    force_y = 0.0 N
    torque = 0.0 N*m

    # -- Gravity --
    force_y = force_y + rckt.mass * GRAVITY

    # -- Aerodynamic Drag --
    v_air_x = rckt.vx - wind_speed
    v_air_y = rckt.vy
    v_mag = math.sqrt(v_air_x^2 + v_air_y^2) -> m/s

    if v_mag > 0.1 m/s then {
        dir_x = math.sin(rckt.angle)
        dir_y = -math.cos(rckt.angle)

        cos_alpha = math.abs(
            dir_x * (v_air_x / v_mag) + dir_y * (v_air_y / v_mag)
        )
        sin_alpha = math.sqrt(1 - cos_alpha^2)

        area_base = math.pi * ROCKET_RADIUS^2
        area_side = 2 * ROCKET_RADIUS * ROCKET_HEIGHT
        effective_area = (area_base * cos_alpha * DRAG_COEFF_BASE) + (
            area_side * sin_alpha * DRAG_COEFF_SIDE
        )

        drag_force = 0.5 * AIR_DENSITY * (v_mag^2) * effective_area

        force_x = force_x - drag_force * (v_air_x / v_mag)
        force_y = force_y - drag_force * (v_air_y / v_mag)
    }

    # -- Engine Thrust --
    if rckt.engine_on and rckt.fuel > 0 then {
        force_x = force_x + ENGINE_THRUST * math.sin(rckt.angle)
        force_y = force_y + ENGINE_THRUST * -math.cos(rckt.angle)

        mass_flow_rate = ENGINE_THRUST / (ISP * GRAVITY)
        rckt.fuel = rckt.fuel - mass_flow_rate * DT
        if rckt.fuel < 0 kg then {rckt.fuel = 0 kg}
    }

    # -- RCS (Reaction Control System / Grid Fins) --
    if rckt.rcs_left then {
        torque = torque - RCS_TORQUE
    }
    if rckt.rcs_right then {
        torque = torque + RCS_TORQUE
    }

    damping_coeff = 10000.0 kg*m
    torque = torque - rckt.omega * (v_mag * damping_coeff)

    # Semi-Implicit Euler Integration
    accel_x = force_x / rckt.mass
    accel_y = force_y / rckt.mass
    rckt.vx = rckt.vx + accel_x * DT
    rckt.vy = rckt.vy + accel_y * DT
    rckt.x = rckt.x + rckt.vx * DT
    rckt.y = rckt.y + rckt.vy * DT

    alpha = torque / moi
    rckt.omega = rckt.omega + alpha * DT
    rckt.angle = rckt.angle + rckt.omega * DT
}

score_landing!() = {
    global rckt, score, landing_bonus

    time_score = math.max(0.0, 1.0 - (wind_time / 40s))
    v_speed_score = math.max(0.0, 1.0 - (math.abs(rckt.vy) / MAX_LANDING_SPEED_Y / 1.3 -> 1))
    h_speed_score = math.max(0.0, 1.0 - (math.abs(rckt.vx) / MAX_LANDING_SPEED_X / 1.3 -> 1))
    angle_score = math.max(0.0, 1.0 - (math.abs(rckt.angle -> °) / MAX_LANDING_ANGLE * 200 -> 1))
    omega_score = math.max(0.0, 1.0 - (math.abs(rckt.omega) / MAX_ROTATION_SPEED * 250 -> 1))
    fuel_score = (rckt.fuel / INITIAL_FUEL -> 1) * 2.25
    pos_score = math.max(0.0, 1.0 - (rckt.x / 30 -> 1))
    landing = v_speed_score * 20 + h_speed_score * 20 + angle_score * 15 + pos_score * 10 + omega_score * 10
    rest = fuel_score * 15 + time_score * 20

    score = math.round(rest * 10)
    landing_bonus = math.round(landing * 10)
}


ctrl!() = {
    global rckt, platform
    if rckt.fuel <= 0 kg then {
        rckt.engine_on = false
        rckt.rcs_left = false
        rckt.rcs_right = false
        return;
    }
    rckt.mass = DRY_MASS + rckt.fuel

    bx = rckt.x - math.sin(rckt.angle) * (ROCKET_HEIGHT / 2)
    by = rckt.y + math.cos(rckt.angle) * (ROCKET_HEIGHT / 2)
    alt_above_pad = math.max(0.0 m, platform.y - by)
    pad_centre = platform.x + platform.w / 2
    x_error = rckt.x - pad_centre # positive = rocket is right of pad

    # Net deceleration available from engine
    net_decel = (ENGINE_THRUST / rckt.mass) - GRAVITY
    if net_decel < 0.5 m/s^2 then { net_decel = 0.5 m/s^2 }

    h_penalty = math.abs(rckt.vx) * 1.5 -> m
    x_penalty = math.abs(x_error) * 0.08 -> m
    stopping_dist = (rckt.vy^2) / (2.0 * net_decel) + BURN_SAFETY_MARGIN + h_penalty + x_penalty

    # Determine phase
    in_phase3 = alt_above_pad < PHASE_FINAL_ALT
    in_phase2 = (not in_phase3) and (
        alt_above_pad < PHASE_BURN_ALT
        or (rckt.vy > BURN_MIN_VY and stopping_dist >= alt_above_pad and rckt.vy > MAX_LANDING_SPEED_Y * BURN_THRESHOLD_FRACTION)
    )
    in_phase1 = (not in_phase2) and (not in_phase3)
    rcs_deadband = 0.0
    lateral_target = 0.0 rad
    max_lean = 0.0 rad

    # Target angle calculation
    if in_phase3 then {
        lateral_target = -(LATERAL_KP * 0.5 * x_error + LATERAL_KD * 0.6 * rckt.vx) -> rad
        max_lean = AUTOPILOT_MAX_LEAN_FINAL -> rad
        rcs_deadband = RCS_DEADBAND_FINAL
    } else if in_phase2 then {
        lateral_target = -(LATERAL_KP * x_error + LATERAL_KD * rckt.vx) -> rad
        max_lean = AUTOPILOT_MAX_LEAN_BURN -> rad
        rcs_deadband = RCS_DEADBAND_BURN
    } else {
        lateral_target = -(LATERAL_KP * x_error + LATERAL_KD * rckt.vx) -> rad
        max_lean = AUTOPILOT_MAX_LEAN_COARSE -> rad
        rcs_deadband = RCS_DEADBAND_COARSE
    }

    target_angle = math.max(-max_lean, math.min(max_lean, lateral_target))


    # Attitude PD controller
    omega_damp_gain = if in_phase3 then 4.0 s*rad^(-1)
                      else if in_phase2 then 2.8 s*rad^(-1)
                      else ATTITUDE_KD
    angle_error = rckt.angle - target_angle
    pd_signal = ATTITUDE_KP * angle_error + omega_damp_gain * rckt.omega
    rckt.rcs_left = pd_signal > rcs_deadband
    rckt.rcs_right = pd_signal < -rcs_deadband

    # Engine control per phase
    if in_phase3 then {
        vy_excess = rckt.vy - FINAL_TARGET_VY
        stopping_now = (rckt.vy^2 - FINAL_TARGET_VY^2) / (2.0 * net_decel)
        must_burn = stopping_now >= alt_above_pad and rckt.vy > FINAL_TARGET_VY
        need_authority = math.abs(rckt.omega) > 0.06 rad/s or math.abs(angle_error) > 0.05 rad
        rckt.engine_on = must_burn or (vy_excess > 1.2 m/s) or need_authority
    } else if in_phase2 then {
        rckt.engine_on = rckt.vy > BURN_MIN_VY
    } else {
        falling = rckt.vy > BURN_MIN_VY
        need_to_slow = rckt.vy > MAX_LANDING_SPEED_Y * BURN_THRESHOLD_FRACTION
        burn_now = stopping_dist >= alt_above_pad
        rckt.engine_on = falling and need_to_slow and burn_now
    }

    # If engine can't beat gravity, fire continuously
    if (ENGINE_THRUST / rckt.mass) <= GRAVITY + 0.5 m/s^2 then {
        rckt.engine_on = rckt.vy > BURN_MIN_VY
    }
}


# ==============================

update_particles!() = {
    global rckt, particles, DT
    new_particles: List[{Particle}] = []
    for p in particles do {
        # Apply drag to simulate air resistance slowing the particles
        p.vx = p.vx * (1.0 - 1.5 * (DT->1))
        p.vy = p.vy * (1.0 - 1.5 * (DT->1))

        # Apply a slight gravity to smoke/exhaust
        p.vy = p.vy + (GRAVITY * 0.1) * DT

        new_x = p.x + p.vx * DT
        new_y = p.y + p.vy * DT

        # Reflection / Collisions with the deck and water
        if new_y >= platform.y then {
            on_pad = (platform.x <= new_x <= platform.x + platform.w)
            if on_pad and new_y < platform.y + 2m then {
                # Platform
                new_y = platform.y
            } else if new_y >= platform.y + 2m then {
                # Water
                new_y = platform.y + 2m
            }
            p.vy = -p.vy * 0.8
        }

        p.x = new_x
        p.y = new_y
        p.vx = p.vx
        p.vy = p.vy
        p.life = p.life - DT

        if p.life >= 0s then {
            new_particles.append(p)
        }
    }
    particles = new_particles
}

update_time!(action_received: Bool) = {
    global last_time, actual_fps, idle_time, fade_time, crashed, crash_time, landed
    # Calculate real delta time and FPS
    current_time = time.now() -> s
    real_dt = current_time - last_time
    last_time = current_time
    if real_dt > 0 then {actual_fps = (1/real_dt)}
    if action_received then {
        idle_time = 0.0 s
    } else {
        idle_time = idle_time + real_dt
    }
    if fade_time > 0.0 s then {
        fade_time = math.max(0.0 s, fade_time - real_dt) -> s
    }
    if crashed or landed then {
        crash_time = crash_time + DT
    }
}

# ==============================
rotate_polygon!(cx: Length, cy: Length, points: List[Length], rad: Angle): List[Length] = {
    rotated: List[Length] = []
    for i in 0..(points.len())..2 do {
        px = points[i]
        py = points[i + 1]
        rotated.append(cx + px * math.cos(rad) - py * math.sin(rad))
        rotated.append(cy + px * math.sin(rad) + py * math.cos(rad))
    }
    return rotated
}

fade_alpha_hex!(t: Time, fade_dur: Time): Str = {
    ratio = math.max(0.0, math.min(1.0, (t / fade_dur) -> 1))
    alpha = math.floor(ratio * 255.0) -> Int
    hex_digits = "0123456789abcdef"
    hi = math.floor(alpha / 16) -> Int
    lo = alpha - hi * 16
    return hex_digits[hi] + hex_digits[lo]
}

# ==============================

draw_telemetry!(alt: Length) = {
    global rckt, landed, crashed, wind_speed, actual_fps, score, landing_bonus

    # HUD (Telemetry)
    fuel_ratio = rckt.fuel / INITIAL_FUEL
    color_idx = math.floor(fuel_ratio * 9.99)

    graphics.rect(0, 0, 260, 208, "#050b14cc")
    graphics.rect(0, 0, 260 * fuel_ratio, 4, fuel_colors[color_idx])

    angle_ = math.round(math.rad_to_deg(rckt.angle))
    fuel_liters = rckt.fuel / FUEL_DENSITY -> 1

    metrics = [
        "ALTITUDE:      " + (roundn(alt) -> Str),
        "V-SPEED:       " + (roundn(-rckt.vy, 1) -> Str),
        "H-SPEED:       " + (roundn(rckt.vx, 1) -> Str),
        "ANGLE:         " + (angle_ -> Str) + "°",
        "FUEL:          " + (roundn(fuel_liters) -> Str) + " L",
        "WIND:          " + (roundn(wind_speed, 1) -> Str),
        "FPS:           " + (math.round(actual_fps) -> Str),
        "SCORE:         " + (score -> Str),
        "LANDING BONUS: " + "+" + (landing_bonus -> Str)
    ]

    text_color = "#e0e0e0"
    text_danger = "#ff5555"
    text_good = "#55ff55"
    hud_x = 10

    for i in 0..metrics.len() do {
        color = text_color
        if i == 1 and rckt.vy > MAX_LANDING_SPEED_Y then {color = text_danger}
        if i == 2 and math.abs(rckt.vx) > MAX_LANDING_SPEED_X then {color = text_danger}
        if i == 3 and math.abs(rckt.angle) > MAX_LANDING_ANGLE then {color = text_danger}
        if i == 8 then {color = text_good}

        hud_y = 12.0 + (i * 20)
        graphics.text(hud_x, hud_y, metrics[i], size=16, color=color)
    }

    # Crash indicator
    if math.abs(rckt.y) < SCREEN_HEIGHT_M/4 and
        (rckt.vy > MAX_LANDING_SPEED_Y
        or math.abs(rckt.vx) > MAX_LANDING_SPEED_X
        or math.abs(rckt.angle) >MAX_LANDING_ANGLE
        or math.abs(rckt.omega) > MAX_ROTATION_SPEED)
    then {
        warning_x = SCREEN_WIDTH / 2
        warning_y = SCREEN_HEIGHT / 2
        tri_w = 35.0
        tri_h = 55.0
        border = 7.0
        c_warn = "#d61818"

        if not ctrl_mode then {
            # Triangle
            graphics.polygon([warning_x, warning_y, warning_x - tri_w, warning_y + tri_h, warning_x + tri_w, warning_y + tri_h], color=c_warn)
            graphics.polygon([warning_x, warning_y + (border * 1.5), warning_x - (tri_w - border*1.5), warning_y + tri_h - border, warning_x + (tri_w - border*1.5), warning_y + tri_h - border], color="#ffffff")

            # !
            graphics.rect(warning_x - 2, warning_y + 18, 4, 18, color=c_warn)
            graphics.rect(warning_x - 2, warning_y + 40, 4, 4, color=c_warn)
        }
    }

    # Final Status Text Banner
    if landed or crashed then {
        banner_w = if landed then 450 else 350
        banner_h = 110
        banner_y = SCREEN_HEIGHT / 2 - (banner_h / 2)
        banner_x = SCREEN_WIDTH / 2 - (banner_w / 2)
        offset = 22
        graphics.rect(banner_x, banner_y, banner_w, banner_h, "#050b14cc")

        if landed then {
            graphics.text(banner_x + offset, banner_y + offset, "LANDING SUCCESSFUL", size=36, color="#00ff66")
        } else {
            graphics.text(banner_x + offset, banner_y + offset, "MISSION FAILED", size=36, color="#ff3333")
        }
        score_text = if landed then " — SCORE: " + ((score + landing_bonus) -> Str) else ""
        graphics.text(banner_x + offset, banner_y + 45 + offset, "PRESS SPACE TO RESTART" + score_text, size=16, color="#aaaaaa")
    }
}

draw_title!() = {
    global started, idle_time, wind_time, fade_time

    # Title Screen
    title_fade_in = 1.4 s
    title_fade_out = 0.8 s

    title_alpha = if not started then
        fade_alpha_hex(idle_time, title_fade_in)
    else
        fade_alpha_hex(math.max(0.0 s, title_fade_out - wind_time) -> s, title_fade_out)

    if title_alpha != "00" then {
        banner_w = 620
        banner_h = 110
        banner_y = SCREEN_HEIGHT / 2 - (banner_h / 2)
        banner_x = SCREEN_WIDTH / 2 - (banner_w / 2)
        offset = 22
        graphics.rect(banner_x, banner_y, banner_w, banner_h, "#050b14" + title_alpha)
        graphics.text(banner_x + offset, banner_y + offset, "FALCON 9 LANDING SIMULATOR", size=36, color="#e0e0e0" + title_alpha)
        graphics.text(banner_x + offset, banner_y + 45 + offset, "PRESS SPACE TO START", size=16, color="#aaaaaa" + title_alpha)
    }
    # Fade Overlay
    if fade_time > 0.0 s then {
        fade_alpha = fade_alpha_hex(fade_time, 0.8 s)
        if fade_alpha != "00" then {
            graphics.rect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, "#000000" + fade_alpha)
        }
    }
}

draw_explosion!() = {
    global rckt, crash_time

    t = crash_time -> 1

    # Initial Flash
    if t < 0.15 then {
        flash_alpha = math.max(0.0, 1.0 - t/0.15)
        graphics.circle(rckt.x, rckt.y, 100.0m, "#ffffff" + fade_alpha_hex(flash_alpha * 1s, 1s))
    }

    # Expanding Shockwave
    wave_r = (t * 250.0) -> m
    wave_alpha = math.max(0.0, 1.0 - t/0.6)
    if wave_alpha > 0.01 then {
        graphics.circle(rckt.x, rckt.y, wave_r, "#ffffff" + fade_alpha_hex(wave_alpha * 0.8s, 1s))
        graphics.circle(rckt.x, rckt.y, wave_r * 0.95, "#ffcc55" + fade_alpha_hex(wave_alpha * 0.4s, 1s))
    }

    # Core Fireball Layers
    fire_alpha = math.max(0.0, 1.0 - t/1.5)
    if fire_alpha > 0.01 then {
        for i in 0..16 do {
            ang = (i * 1.88 + 1.0) -> rad
            dist = (t * 25.0 * (1.0 + math.sin((i * 2.7) -> rad))) -> m
            fx = rckt.x + math.cos(ang) * dist
            fy = rckt.y + math.sin(ang) * dist - (t * 20.0m)

            fr = math.max(0.0, (1.5 - t) * (18.0 + math.sin((i * 3.2) -> rad)*8.0)) -> m

            col = fire_colors[i]
            graphics.circle(fx, fy, fr, col + fade_alpha_hex(fire_alpha * 1s, 1s))
        }
    }

    # Lingering Smoke Cloud
    smoke_alpha = math.max(0.0, 1.0 - t/1.5)
    if smoke_alpha > 0.01 then {
        for i in 0..9 do {
            sx = rckt.x + ((math.sin((i * 1.1) -> rad) * 25.0 * t) -> m)
            sy = rckt.y - ((t * (15.0 + i * 2.5)) -> m)
            sr = (t * 20.0 + 12.0 + i * 3.0) -> m
            graphics.circle(sx, sy, sr, "#1a1a1a" + fade_alpha_hex(smoke_alpha * 0.6s, 1s))
        }
    }

    # Flying Tumbling Debris
    deb_alpha = math.max(0.0, 1.0 - t/3.0)
    if deb_alpha > 0.01 then {
        for i in 0..26 do {
            # Bias upward scatter angles
            ang = (i * 0.25 - 1.57 + math.sin((i * 2.0) -> rad)*0.8) -> rad
            speed = 30.0 + math.sin((i * 4.1) -> rad) * 25.0
            dx = math.cos(ang) * speed * t
            dy = math.sin(ang) * speed * t + 0.5 * 9.81 * t * t

            deb_x = rckt.x + (dx -> m)
            deb_y = rckt.y + (dy -> m)

            # Floor stop
            if deb_y > platform.y then {
                deb_y = platform.y
            }

            size_deb = (1.5 + math.sin((t * 15.0 + i) -> rad) * 0.5) -> m

            graphics.rect(deb_x, deb_y, size_deb, size_deb, "#111111" + fade_alpha_hex(deb_alpha * 1s, 1s))
        }
    }
}

# ==============================

main!() = {
    global rckt, particles, started, crashed, landed, idle_time, wind_time, wind_speed, last_time, actual_fps, fade_time, crash_time, score, FPS, DT, ctrl_mode

    while not graphics.quit_requested() do {
        if graphics.key_pressed("A") then {
            ctrl_mode = not ctrl_mode
            while graphics.key_pressed("A") do {}
        }

        if ctrl_mode and not landed and not crashed then {
            ctrl()
        } else {
            rckt.engine_on = graphics.key_pressed("Up")
            rckt.rcs_left  = if INVERT then graphics.key_pressed("Right") else graphics.key_pressed("Left")
            rckt.rcs_right = if INVERT then graphics.key_pressed("Left")  else graphics.key_pressed("Right")
        }

        for i in 0..10 do {
            fps = i -> Str
            if graphics.key_pressed(fps) then {
                FPS = if i != 0 then i*10 else 5
                DT = 1.0 / FPS -> s
            }
        }

        if graphics.key_pressed("Space") then {
            if not started then {
                started = true
            } else {
                reset()
                started = true # skip title screen
                fade_time = 0.8 s
            }
            while graphics.key_pressed("Space") do {}
        }

        manual_input = graphics.key_pressed("Up") or graphics.key_pressed("Left") or graphics.key_pressed("Right")
        action_received = manual_input or graphics.key_pressed("Space") or (ctrl_mode and started and not crashed and not landed)

        if not started and (manual_input or graphics.key_pressed("Space")) then {
            started = true
        }

        update_time(action_received)
        # Reset to title screen after inactivity cooldown
        if started and idle_time > INACTIVITY_COOLDOWN then {
            reset()
        }

        # Update physics and game state
        wind_time = wind_time + DT
        wind_speed = (
            math.sin(wind_time * 0.5) * 6.0 + math.sin(wind_time * 1.3) * 3.0
        ) -> m/s

        if not (crashed or landed) and started then
            update_physics()
        update_particles()

        bx = rckt.x - math.sin(rckt.angle) * (ROCKET_HEIGHT / 2)
        by = rckt.y + math.cos(rckt.angle) * (ROCKET_HEIGHT / 2)

        # Boundary Check: Crash if falling off the sides of the world
        if math.abs(rckt.x) > SCREEN_WIDTH_M / 2 + ROCKET_RADIUS then { crashed = true; }

        if not landed and not crashed then {
            if started then {
                score_landing()
            }
            if by >= platform.y then {
                base_span = ROCKET_RADIUS * math.cos(rckt.angle)
                left_edge = bx - base_span
                right_edge = bx + base_span
                on_pad = (platform.x <= left_edge) and (right_edge <= platform.x + platform.w)

                if (
                    on_pad
                    and rckt.vy <= MAX_LANDING_SPEED_Y
                    and math.abs(rckt.vx) <= MAX_LANDING_SPEED_X
                    and math.abs(rckt.angle) <= MAX_LANDING_ANGLE
                    and math.abs(rckt.omega) <= MAX_ROTATION_SPEED
                ) then {
                    landed = true
                    rckt.y = platform.y - math.cos(rckt.angle) * (ROCKET_HEIGHT / 2)
                } else {
                    crashed = true
                    rckt.y = platform.y
                }
            }
        }

        if crashed or landed then {
            rckt.vx = 0.0 m/s
            rckt.vy = 0.0 m/s
            rckt.angle = 0.0 rad
            rckt.omega = 0.0 rad/s
        }

        # ==============================
        # -- RENDERING --
        # ==============================
        if AUTOZOOM then {
            dist = math.sqrt(rckt.x^2 + (platform.y - rckt.y)^2) -> m
            view_height = math.max(240.0, math.min(SCREEN_HEIGHT_M, dist + 150m))
            graphics.set_scale(view_height, SCREEN_HEIGHT)
        } else {
            graphics.set_scale(SCALE)
        }
        shake = if rckt.engine_on then random.uniform(-1, 1) else
                if crashed and crash_time < 1s then random.uniform(-7, 7) else 0
        graphics.set_origin(SCREEN_WIDTH / 2 + shake, SCREEN_HEIGHT + shake)


        # Sky
        band_h = SCREEN_HEIGHT_M / sky_colors.len()
        for i in 0..sky_colors.len() do {
            graphics.rect(-SCREEN_WIDTH_M / 2, -SCREEN_HEIGHT_M + (i * band_h), SCREEN_WIDTH_M, band_h + 1m, sky_colors[i])
        }

        # Ocean
        ocean_base_y = platform.y + 2m
        graphics.rect(-SCREEN_WIDTH_M / 2, ocean_base_y, SCREEN_WIDTH_M, SCREEN_HEIGHT_M, "#0f5e9c")

        # Landing Pad
        deck_y = platform.y

        # Thrusters
        graphics.rect(platform.x - 4m, deck_y + 2m, 4m, 4m, "#555555") # Left thruster
        graphics.rect(platform.x + platform.w, deck_y + 2m, 4m, 4m, "#555555") # Right thruster

        # Main Deck and Hull
        graphics.rect(platform.x, deck_y, platform.w, platform.h, "#2a2a2a") # Deck surface
        graphics.rect(platform.x, deck_y + platform.h - 1m, platform.w, 2m, "#111111") # Shadow/Hull depth

        # Droneship Deck Markings
        graphics.rect(platform.x, deck_y, platform.w, 0.8m, "#ffcc00") # Forward edge caution line
        graphics.rect(platform.x + 2m, deck_y, 1.5m, platform.h, "#ffcc00") # Left caution
        graphics.rect(platform.x + platform.w - 3.5m, deck_y, 1.5m, platform.h, "#ffcc00") # Right caution

        # Center 'X'
        cx = platform.x + platform.w / 2
        cy = deck_y + platform.h / 2
        graphics.line(cx - 6m, cy - 1.5m, cx + 6m, cy + 1.5m, thickness=3.0, color="#ffffff")
        graphics.line(cx - 6m, cy + 1.5m, cx + 6m, cy - 1.5m, thickness=3.0, color="#ffffff")


        # Rocket
        alt = math.max(0.0, platform.y - by) -> m

        if not crashed then {
            w_r = ROCKET_RADIUS
            h_r = ROCKET_HEIGHT / 2
            body_bot_y = h_r - 6m
            skirt_bot_y = h_r - 1m
            nozzle_bot_y = h_r + 2m

            # RCS Plumes
            rcs_offset_y = -h_r + 2.5m
            if rckt.rcs_left then {
                rcs_len = random.uniform(3.0, 6.0) -> m
                rcs_pts = rotate_polygon(rckt.x, rckt.y, [w_r, rcs_offset_y, w_r+rcs_len, rcs_offset_y-2m, w_r+(rcs_len*0.8), rcs_offset_y+1m], rckt.angle)
                graphics.polygon(rcs_pts, "#ffffffcc")
            }

            if rckt.rcs_right then {
                rcs_len = random.uniform(3.0, 6.0) -> m
                rcs_pts = rotate_polygon(rckt.x, rckt.y, [-w_r, rcs_offset_y, -w_r-rcs_len, rcs_offset_y-2m, -w_r-(rcs_len*0.8), rcs_offset_y+1m], rckt.angle)
                graphics.polygon(rcs_pts, "#ffffffcc")
            }

            # Interstage (Top)
            is_h = 5m # Length of the black interstage section
            is_pts = rotate_polygon(rckt.x, rckt.y, [-w_r, -h_r, w_r, -h_r, w_r, -h_r + is_h, -w_r, -h_r + is_h], rckt.angle)
            graphics.polygon(is_pts, "#151515")

            # Grid Fins
            for s in [-1, 1] do {
                gf = rotate_polygon(rckt.x, rckt.y, [s*w_r, -h_r+1.2m, s*(w_r+1.2m), -h_r+1.8m, s*(w_r+1.2m), -h_r+3.8m, s*w_r, -h_r+4.4m], rckt.angle)
                graphics.polygon(gf, "#252525")
            }

            # Main Body
            steps = rocket_colors.len()
            strip_w = (2.0 * w_r) / steps
            for i in 0..steps do {
                lx = -w_r + (i * strip_w)
                rx = lx + strip_w
                b_pts = rotate_polygon(rckt.x, rckt.y, [lx, -h_r + is_h, rx, -h_r + is_h, rx, body_bot_y, lx, body_bot_y], rckt.angle)
                graphics.polygon(b_pts, rocket_colors[i])
            }

            # Nozzle & Engine Section
            skirt_pts_dark = rotate_polygon(rckt.x, rckt.y, [-w_r, body_bot_y, 0m, body_bot_y, 0m, skirt_bot_y, -w_r * 1.12, skirt_bot_y], rckt.angle)
            skirt_pts_light = rotate_polygon(rckt.x, rckt.y, [0.0m, body_bot_y, w_r, body_bot_y, w_r * 1.12, skirt_bot_y, 0m, skirt_bot_y], rckt.angle)
            graphics.polygon(skirt_pts_dark, "#1a1a1a")
            graphics.polygon(skirt_pts_light, "#2e2e2e")

            nozzle_pts_dark = rotate_polygon(rckt.x, rckt.y, [-w_r * 0.55, skirt_bot_y, 0m, skirt_bot_y, 0m, nozzle_bot_y, -w_r * 0.78, nozzle_bot_y], rckt.angle)
            nozzle_pts_light = rotate_polygon(rckt.x, rckt.y, [0.0m, skirt_bot_y, w_r * 0.55, skirt_bot_y, w_r * 0.78, nozzle_bot_y, 0m, nozzle_bot_y], rckt.angle)
            graphics.polygon(nozzle_pts_dark, "#2a2a2a")
            graphics.polygon(nozzle_pts_light, "#3d3d3d")

            nozzle_inner = rotate_polygon(rckt.x, rckt.y, [-w_r * 0.42, nozzle_bot_y - 0.5m, w_r * 0.42, nozzle_bot_y - 0.5m, w_r * 0.52, nozzle_bot_y, -w_r * 0.52, nozzle_bot_y], rckt.angle)
            graphics.polygon(nozzle_inner, "#111111")

            # Landing Legs
            if alt < 50.0 m or landed then {
                leg_ext = if landed then 1.0 else (50.0m - alt) / 40.0m
                leg_ext = math.max(0.0, math.min(1.0, leg_ext))

                # Geometry math for both sides
                for side in [-1, 1] do {
                    root_x = side * w_r
                    root_y = body_bot_y + 1m
                    tip_x = side * (w_r + (8.5m * leg_ext))
                    tip_y = skirt_bot_y + (3.5m * leg_ext)

                    # Primary Strut
                    leg_p = rotate_polygon(rckt.x, rckt.y, [root_x, root_y, tip_x, tip_y], rckt.angle)
                    graphics.line(leg_p[0], leg_p[1], leg_p[2], leg_p[3], thickness=3.5, color="#111111")

                    # Actuator Strut
                    leg_a = rotate_polygon(rckt.x, rckt.y, [side * w_r, skirt_bot_y - 1m, tip_x, tip_y], rckt.angle)
                    graphics.line(leg_a[0], leg_a[1], leg_a[2], leg_a[3], thickness=1.5, color="#333333")

                    # Footpad
                    pad = rotate_polygon(rckt.x, rckt.y, [tip_x - 1.2m, tip_y, tip_x + 1.2m, tip_y, tip_x + 1.0m, tip_y + 0.4m, tip_x - 1.0m, tip_y + 0.4m], rckt.angle)
                    graphics.polygon(pad, "#050505")
                }
            }

            # Engine Flame & Particles
            if rckt.engine_on and rckt.fuel > 0 and not landed then {
                flame_h = random.uniform(17.0, 32.0) -> m
                flicker_w = random.uniform(0.8, 1.1)

                f_out = rotate_polygon(rckt.x, rckt.y, [-w_r*flicker_w, h_r, w_r*flicker_w, h_r, 0m, h_r+flame_h], rckt.angle)
                graphics.polygon(f_out, "#ff66005b")

                f_mid = rotate_polygon(rckt.x, rckt.y, [-w_r*0.6, h_r, w_r*0.6, h_r, 0m, h_r+(flame_h*0.7)], rckt.angle)
                graphics.polygon(f_mid, "#ffaa0080")

                f_in = rotate_polygon(rckt.x, rckt.y, [-w_r*0.3, h_r, w_r*0.3, h_r, 0m, h_r+(flame_h*0.4)], rckt.angle)
                graphics.polygon(f_in, "#ffffffa8")

                # Spawn particles
                for j in 0..18 do {
                    # Spatially distribute across the nozzle's horizontal width
                    offset = random.uniform(-0.8, 0.8) -> m
                    p_x = bx + math.cos(rckt.angle) * offset
                    p_y = by + math.sin(rckt.angle) * offset

                    # Core particles are fast and straight; edge particles are slower and rckt.angled
                    core_factor = 1.0 - (math.abs(offset) / 0.8)
                    spread = random.uniform(-0.35, 0.35) * (1.2 - core_factor)
                    exhaust_vel = (random.uniform(30.0, 50.0) -> m/s) + (core_factor * 30.0 m/s)
                    p_life = random.uniform(0.6, 1.5) -> s

                    particles.append(
                        Particle(p_x, p_y,
                            vx = rckt.vx - math.sin(rckt.angle + spread) * exhaust_vel,
                            vy = rckt.vy + math.cos(rckt.angle + spread) * exhaust_vel,
                            life = p_life,
                            max_life = p_life,
                            color = "#ffaa00"
                        )
                    )
                }
            }
        } else {
            draw_explosion()
        }

        if crash_time == 0.0 and crashed then graphics.play_sound("boom.wav")
        if crash_time == 0.0 and landed then graphics.play_sound("win.wav")

        # Render Exhaust Particles
        for p in particles do {
            life_ratio = p.life / p.max_life
            color_idx = math.floor(life_ratio * 9.99) -> Int
            p_size = (1.2 - life_ratio) * 150cm
            graphics.circle(p.x, p.y, p_size, exhaust_colors[color_idx])
        }

        # Reset scale and origin for UI
        graphics.set_scale(1)
        graphics.set_origin(0, 0)

        draw_telemetry(alt)
        draw_title()

        graphics.blit()
    }
}

main()
